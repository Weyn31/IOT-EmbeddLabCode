#include <Wire.h>
#include <LiquidCrystal_I2C.h>

const int SDA_PIN = 16, SCL_PIN = 17;
const int SOIL_PIN    = 34;              
const int RAIN_DO_PIN = 35;            
const int PUMP_PIN    = 22;              
const int VALVE_PIN   = 23;              

const int LED_IDLE_PIN  = 18;            
const int LED_RUN_PIN   = 19;            
const int LED_HOLD_PIN  = 21;            
const int LED_FAULT_PIN = 5;             
const int BUZZER_PIN    = 15;
const int TANK_PIN      = -1;            
                                        

#define RELAY_ON  LOW
#define RELAY_OFF HIGH

const int SOIL_DRY_RAW = 3300;           
const int SOIL_WET_RAW = 1400;           
const unsigned long SETTLE_MS = 1500;    
int   setpointPct = 40;                  
float moistMargin = 8.0;                 

const int ST_IDLE = 0, ST_IRRIG = 1, ST_HOLD = 2, ST_FAULT = 3;
const char* ST_TEXT[] = {"IDLE", "IRRIGATING", "HOLD-RAIN", "TANK EMPTY"};

enum PumpPhase { PH_IDLE, PH_OPENING, PH_RUNNING, PH_CLOSING };
const char* PH_NAMES[] = {"IDLE", "OPENING", "RUNNING", "CLOSING"};
PumpPhase phase = PH_IDLE;
unsigned long tPhase = 0, runStarted = 0;

LiquidCrystal_I2C lcd(0x27, 16, 2);     

float soilPct = 100;
int   soilRaw = 0;
bool  raining = false;
bool  tankSim = true;                    
bool  irrigating = false;               
unsigned long pumpStarts = 0, startsThisMin = 0;


inline void pumpOn()   { digitalWrite(PUMP_PIN,  RELAY_ON);  }
inline void pumpOff()  { digitalWrite(PUMP_PIN,  RELAY_OFF); }
inline void valveOn()  { digitalWrite(VALVE_PIN, RELAY_ON);  }
inline void valveOff() { digitalWrite(VALVE_PIN, RELAY_OFF); }


bool tankHasWater() {
  if (TANK_PIN >= 0) return digitalRead(TANK_PIN) == LOW;
  return tankSim;
}

void readSensors() {
  long sum = 0;
  for (int i = 0; i < 8; i++) sum += analogRead(SOIL_PIN);   
  soilRaw = sum / 8;
  soilPct = constrain((float)(SOIL_DRY_RAW - soilRaw) * 100.0 /
                      (SOIL_DRY_RAW - SOIL_WET_RAW), 0.0, 100.0);
  raining = (digitalRead(RAIN_DO_PIN) == LOW);
}



bool moistureCallsForWater() {
  float pct = soilPct;
  if (!irrigating && pct <  setpointPct) irrigating = true;
  if ( irrigating && pct >= setpointPct + moistMargin) irrigating = false;
  return irrigating;
}

void servicePump(bool wantRun) {
  unsigned long now = millis();
  switch (phase) {
    case PH_IDLE:
      if (wantRun) { valveOn(); tPhase = now; phase = PH_OPENING; }
      break;
    case PH_OPENING:                                   
      if (!wantRun) { tPhase = now; phase = PH_CLOSING; }       
      else if (now - tPhase >= SETTLE_MS) {
        pumpOn(); runStarted = now; phase = PH_RUNNING;
        pumpStarts++; startsThisMin++;
        Serial.printf("[pump] ON  #%lu at %lu ms, soil %.0f %%\n", pumpStarts, now, soilPct);
      }
      break;
    case PH_RUNNING:
      if (!wantRun) {
        pumpOff(); tPhase = now; phase = PH_CLOSING;
        Serial.printf("[pump] OFF at %lu ms after %.1f s, soil %.0f %%\n",
                      now, (now - runStarted) / 1000.0, soilPct);
      }
      break;
    case PH_CLOSING:                                   
      if (now - tPhase >= SETTLE_MS) { valveOff(); phase = PH_IDLE; }
      break;
  }
}

int currentState() {
  if (!tankHasWater())  return ST_FAULT;
  if (phase != PH_IDLE) return ST_IRRIG;
  if (raining)          return ST_HOLD;
  return ST_IDLE;
}

void setLeds(int st) {
  digitalWrite(LED_IDLE_PIN,  st == ST_IDLE  ? HIGH : LOW);
  digitalWrite(LED_RUN_PIN,   st == ST_IRRIG ? HIGH : LOW);
  digitalWrite(LED_HOLD_PIN,  st == ST_HOLD  ? HIGH : LOW);
  digitalWrite(LED_FAULT_PIN, st == ST_FAULT ? HIGH : LOW);
}

void updateBuzzer(int st) {
  bool on = false;
  if (st == ST_FAULT) {
    unsigned long ph = millis() % 2000;
    on = (ph < 120) || (ph >= 300 && ph < 420) || (ph >= 600 && ph < 720);
  }
  digitalWrite(BUZZER_PIN, on ? HIGH : LOW);
}

void lcdLine(int row, const char* s) {
  char buf[17];
  snprintf(buf, sizeof(buf), "%-16s", s);
  lcd.setCursor(0, row);
  lcd.print(buf);
}

void updateLcd(int st) {
  static unsigned long t = 0;
  unsigned long now = millis();
  if (now - t < 300) return;
  t = now;
  char l0[24], l1[24];
  snprintf(l0, sizeof(l0), "Soil:%3d%% Set:%2d%%", (int)soilPct, setpointPct);
  snprintf(l1, sizeof(l1), "M+%-2d %s", (int)moistMargin, ST_TEXT[st]);
  lcdLine(0, l0);
  lcdLine(1, l1);
}

void ledSelfTest() {
  const int pins[4] = {LED_IDLE_PIN, LED_RUN_PIN, LED_HOLD_PIN, LED_FAULT_PIN};
  const char* names[4] = {"IDLE LED", "IRRIGATING LED", "HOLD LED", "FAULT LED"};
  lcdLine(0, "LED self-test");
  for (int i = 0; i < 4; i++) {
    lcdLine(1, names[i]);
    Serial.printf("[test] %s on GPIO %d\n", names[i], pins[i]);
    digitalWrite(pins[i], HIGH);
    delay(700);
    digitalWrite(pins[i], LOW);
  }
  lcdLine(1, "BUZZER");
  Serial.println("[test] buzzer");
  digitalWrite(BUZZER_PIN, HIGH); delay(300); digitalWrite(BUZZER_PIN, LOW);
}

void printStatus() {
  Serial.printf("[status] soil=%.0f%% (raw %d) set=%d%% margin=%.1f latch=%d rain=%d tank=%d phase=%s starts=%lu\n",
                soilPct, soilRaw, setpointPct, moistMargin, irrigating, raining,
                tankHasWater(), PH_NAMES[phase], pumpStarts);
}

void logCsv() {
  static unsigned long t = 0;
  unsigned long now = millis();
  if (now - t < 1000) return;
  t = now;
  Serial.printf("LOG,%lu,%.0f,%d,%.1f,%d,%s,%s,%lu\n", now, soilPct, setpointPct,
                moistMargin, irrigating, ST_TEXT[currentState()], PH_NAMES[phase], pumpStarts);
}

void reportStarts() {
  static unsigned long t = 0;
  unsigned long now = millis();
  if (now - t < 60000UL) return;
  t = now;
  Serial.printf("[stats] pump starts in the last 60 s: %lu (total %lu)\n", startsThisMin, pumpStarts);
  startsThisMin = 0;
}

void handleSerial() {
  if (!Serial.available()) return;
  String line = Serial.readStringUntil('\n');
  line.trim();
  float v = 0;
  if (sscanf(line.c_str(), "setpoint %f", &v) == 1)    { setpointPct = (int)v; Serial.printf("setpoint = %d %%\n", setpointPct); }
  else if (sscanf(line.c_str(), "margin %f", &v) == 1) { moistMargin = v;      Serial.printf("margin = %.1f\n", v); }
  else if (sscanf(line.c_str(), "tank %f", &v) == 1)   { tankSim = (v != 0);   Serial.printf("tank %s\n", tankSim ? "has water" : "EMPTY"); }
  else if (line == "ledtest")  { ledSelfTest(); }
  else if (line == "reset")    { pumpStarts = 0; startsThisMin = 0; Serial.println("counters reset"); }
  else if (line == "status")   { printStatus(); }
  else if (line.length())      { Serial.println("commands: setpoint <n>, margin <n>, tank 0|1, ledtest, reset, status"); }
}

void setup() {
  // Relays first, so the actuators can never glitch on at boot.
  digitalWrite(PUMP_PIN, RELAY_OFF);  pinMode(PUMP_PIN, OUTPUT);  pumpOff();
  digitalWrite(VALVE_PIN, RELAY_OFF); pinMode(VALVE_PIN, OUTPUT); valveOff();

  Serial.begin(115200);
  Serial.println("\nLAB 5 - PART F: status indication and hysteresis");
  Serial.println("LOG,ms,soil_pct,setpoint_pct,margin,latch,state,phase,pump_starts");

  int outs[] = {LED_IDLE_PIN, LED_RUN_PIN, LED_HOLD_PIN, LED_FAULT_PIN, BUZZER_PIN};
  for (int p : outs) { pinMode(p, OUTPUT); digitalWrite(p, LOW); }
  pinMode(RAIN_DO_PIN, INPUT);
  pinMode(SOIL_PIN, INPUT);
  if (TANK_PIN >= 0) pinMode(TANK_PIN, INPUT_PULLUP);

  Wire.begin(SDA_PIN, SCL_PIN);
  lcd.init();
  lcd.backlight();

  ledSelfTest();
  readSensors();
  printStatus();
}

void loop() {
  handleSerial();

  static unsigned long tRead = 0;
  if (millis() - tRead >= 250) { tRead = millis(); readSensors(); }

  // Decision: a fault or rain holds the pump off; otherwise the hysteresis latch decides.
  bool prevLatch = irrigating;
  bool call = moistureCallsForWater();
  if (call != prevLatch) {
    Serial.printf("[hyst] latch %s at soil %.0f %% (set %d, margin %.1f)\n",
                  call ? "ON " : "OFF", soilPct, setpointPct, moistMargin);
  }
  bool want = call && tankHasWater() && !raining;
  servicePump(want);

  int st = currentState();
  setLeds(st);
  updateBuzzer(st);
  updateLcd(st);
  logCsv();
  reportStarts();
} 
